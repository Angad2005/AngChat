{
  "name": "angchat",
  "version": "1.0.0",
  "description": "AngChat, a local-first coding agent for hosted and local AI models.",
  "license": "MIT",
  "bin": {
    "chat": "bin/chat.js"
  },
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "install:backend": "npm install --prefix backend",
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "test": "npm --prefix backend test",
    "chat": "node bin/chat.js",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "wrangler": "^4.155.0"
  }
}
