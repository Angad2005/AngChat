# Server
PORT=3000
HOST=127.0.0.1
SESSION_SECRET=replace-with-a-long-random-secret
# Set to 1 only when the app sits behind a trusted HTTPS reverse proxy.
TRUST_PROXY=0
# Optional initial project directory for Code mode. A project selected in Settings
# is saved to .chat/workspace.local.json; this variable overrides it at startup.
CHAT_WORKSPACE=

# Default provider: local, ollama, openai, nebius, 9router, nvidia, anthropic, gemini, or mock
# "Nvidia-nim" is also accepted and normalized to "nvidia".
LLM_PROVIDER=Nvidia-nim
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
# Provider-specific keys can also be used instead of LLM_API_KEY:
# OPENAI_API_KEY=...
# NEBIUS_API_KEY=...
# NINE_ROUTER_API_KEY=...
# NVIDIA_NIM_API_KEY=...
# ANTHROPIC_API_KEY=...
# GEMINI_API_KEY=...
# Local OpenAI-compatible keys: LM_STUDIO_API_KEY=...
# 9Router example (copy the key from the 9Router dashboard):
# LLM_PROVIDER=9router
# LLM_MODEL=model-id-from-the-9router-dashboard
# LLM_BASE_URL=http://localhost:20128/v1
# LLM_API_KEY=your_9router_api_key
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
# auto | in-process | llama-server | ollama
LLM_INFERENCE_ENGINE=auto
# Set to 1 only if you explicitly want local prompt/response traces in .chat/traces/.
CHAT_CAPTURE_TRACES=0

# Optional llama.cpp runtime. Chat discovers llama-server on PATH when this is blank.
# Set an absolute path here to use a particular llama-server executable instead.
# Windows example: LLAMA_SERVER_PATH=C:\tools\llama.cpp\llama-server.exe
# Linux example: LLAMA_SERVER_PATH=/usr/local/bin/llama-server
LLAMA_SERVER_PATH=
