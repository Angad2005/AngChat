# Server
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
# Set to 1 only when the app sits behind a trusted HTTPS reverse proxy.
TRUST_PROXY=0

# Default provider: local, openai, anthropic, gemini, or mock
LLM_PROVIDER=mock
LLM_MODEL=angchat-demo
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# Optional llama.cpp runtime. AngChat discovers llama-server on PATH when this is blank.
# Set an absolute path here to use a particular llama-server executable instead.
# Windows example: LLAMA_SERVER_PATH=C:\tools\llama.cpp\llama-server.exe
# Linux example: LLAMA_SERVER_PATH=/usr/local/bin/llama-server
LLAMA_SERVER_PATH=
