# Server
PORT=3000
HOST=127.0.0.1
SESSION_SECRET=replace-with-a-long-random-secret
# Set to 1 only when the app sits behind a trusted HTTPS reverse proxy.
TRUST_PROXY=0
# Optional initial project directory for Code mode. A project selected in Settings
# is saved to .chat/workspace.local.json; this variable overrides it at startup.
CHAT_WORKSPACE=

# Default provider: local, ollama, openai, nebius, anthropic, gemini, or mock
LLM_PROVIDER=mock
LLM_MODEL=angchat-demo
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
# auto | in-process | llama-server | ollama
LLM_INFERENCE_ENGINE=auto
# Set to 1 only if you explicitly want local prompt/response traces in .chat/traces/.
CHAT_CAPTURE_TRACES=0

# Optional llama.cpp runtime. Chat discovers llama-server on PATH when this is blank.
# Set an absolute path here to use a particular llama-server executable instead.
# Windows example: LLAMA_SERVER_PATH=C:\tools\llama.cpp\llama-server.exe
# Linux example: LLAMA_SERVER_PATH=/usr/local/bin/llama-server
LLAMA_SERVER_PATH=
